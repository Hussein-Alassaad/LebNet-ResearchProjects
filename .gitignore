# Results (regenerate via scripts; keep dir but not every artifact)
results/*.png
results/*.csv
!results/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment / secrets
.env

# Jupyter
*.ipynb_checkpoints
